name: Pulse Operational Health Report
on:
 workflow_dispatch:
 schedule:
   - cron: '17 6 * * *'
permissions:
 contents: read
jobs:
 health-report:
   runs-on: ubuntu-24.04
   steps:
     - uses: actions/checkout@v6
     - uses: actions/setup-python@v6
       with:
         python-version: '3.12'
     - name: Start Pulse server
       run: |
         python app/server.py &
         sleep 3
     - name: Generate health report
       run: python scripts/health_report.py
     - name: Upload health report
       uses: actions/upload-artifact@v4
       with:
         name: pulse-health-report
         path: reports/health-report.md
